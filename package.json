{
  "name": "finocurve-app",
  "version": "1.5.0",
  "description": "FinoCurve Desktop - Modern Investment Banking",
  "author": "finocurve llc",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:electron": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --coverage --config vitest.electron.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package:dir": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "verify:release": "npm run test:coverage && npm run test:electron && npm run package:dir",
    "ci": "npm ci --legacy-peer-deps",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --mac",
    "dist:arm": "npm run build && electron-builder --mac --arm64",
    "dist:intel": "npm run build && electron-builder --mac --x64",
    "dist:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:win:x64": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "dist:win:arm64": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --arm64",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "build": {
    "appId": "com.finocurve.app",
    "productName": "FinoCurve",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/images/finocurve-logo-512.png",
      "category": "public.app-category.finance"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "public/images/finocurve.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@langchain/aws": "^1.5.2",
    "@langchain/core": "^1.3.5",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.8.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vnedyalk0v/react19-simple-maps": "^2.0.12",
    "better-sqlite3": "^13.0.3",
    "country-list": "^2.4.1",
    "dompurify": "^3.4.17",
    "html-to-text": "^10.0.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "node-emoji": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "react-tooltip": "^6.0.10",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "yahoo-finance2": "^4.0.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/country-list": "^2.1.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "release-it": "^21.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "path-to-regexp": "8.4.2",
    "node-abi": "4.40.0",
    "cosmiconfig": {
      "yaml": "1.10.3"
    },
    "js-yaml": "4.3.2",
    "fast-uri": "3.1.9",
    "ip-address": "10.7.6",
    "hono": "4.13.17",
    "@hono/node-server": "2.1.6",
    "qs": "6.17.1",
    "fflate": "0.8.3",
    "body-parser": "2.4.0",
    "proxy-addr": "2.0.8",
    "basic-ftp": "6.2.6",
    "tar": "7.5.22",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "minimatch@7": "11.0.5",
    "minimatch@8": "11.0.5",
    "minimatch@9": "11.0.5",
    "minimatch@10": "11.0.5",
    "minimatch@11": "11.0.5",
    "node-gyp": {
      "undici": "6.29.1"
    }
  }
}
